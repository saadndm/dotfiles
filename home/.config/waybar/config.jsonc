{
  "reload_style_on_change": true,
  "margin-right": 3,
  "margin-left": 3,
  "margin-top": 3,
  "margin-bottom": 0,
  "height": 30,
  "modules-left": [
    "hyprland/workspaces",
    "cpu",
    "memory",
    "temperature#cpu",
    "power-profiles-daemon"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "tray",
    "idle_inhibitor",
    "network",
    "bluetooth",
    "backlight",
    "wireplumber",
    "upower"
  ],
  "hyprland/workspaces": {
    "cursor": true
  },
  "cpu": {
    "interval": 1,
    "format": "{usage}% <span font='Font Awesome 6 Pro Solid'>&#xf2db;</span>",
    "states": {
      "warning": 50,
      "critical": 80
    }
  },
  "memory": {
    "interval": 1,
    "format": "{percentage}% <span font='Font Awesome 6 Pro Solid'>&#xf538;</span>",
    "tooltip-format": "{used}/{total} GiB",
    "states": {
      "warning": 50,
      "critical": 80
    }
  },
  "temperature#cpu": {
    "interval": 1,
    "thermal-zone": 5,
    "critical-threshold": 80,
    "format": "{temperatureC}°C <span font='Font Awesome 6 Pro Solid'></span>",
    "tooltip": false
  },
  "power-profiles-daemon": {
    "interval": "once",
    "format": "<span font='Font Awesome 6 Pro Solid'>{icon}</span>",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },
  "clock": {
    "interval": 60,
    "format": "{:%H:%M / %h %d}",
    "tooltip": true,
    "tooltip-format": "<tt>{calendar}</tt>",
    "cursor": false,
    "calendar": {
      "mode"          : "year",
      "mode-mon-col"  : 3,
      "weeks-pos"     : "right",
      "on-scroll"     : 1,
      "format": {
        "months":     "<span color='#ffead3'><b>{}</b></span>",
        "days":       "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks":      "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays":   "<span color='#ffcc66'><b>{}</b></span>",
        "today":      "<span color='#ff6699'><b><u>{}</u></b></span>"
      }
    },
    "actions":  {
      "on-click-right": "mode",
      "on-scroll-up": "tz_up",
      "on-scroll-down": "tz_down",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "tray": {
    "interval": "once",
    "spacing": 10
  },
  "idle_inhibitor": {
    "interval": "once",
    "format": "<span font='Font Awesome 6 Pro Solid'>{icon}</span>",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    },
    "tooltip": true
  },
  "network": {
    "interval": 10,
    "format-wifi": "<span font='Font Awesome 6 Pro Solid'>{icon}</span>",
    "format-ethernet": "<span font='Font Awesome 6 Pro Solid'></span>",
    "format-icons": [
      "",
      "",
      ""
    ],
    "format-disconnected": "<span font='Font Awesome 6 Pro Solid'></span>",
    "format-disabled": "<span font='Font Awesome 6 Pro Solid'></span>",
    "tooltip-format-wifi": " {bandwidthDownBytes} |  {bandwidthUpBytes} | {essid} | {signalStrength}%",
    "tooltip-format-disconnected": "Disconnected",
    "tooltip-format-disabled": "Disabled",
    "on-click": "kitty --class Impala -e impala",
    "on-click-right": "bash -c \"rfkill list wifi | grep -q 'Soft blocked: yes' && rfkill unblock wifi || rfkill block wifi\"",
  },
  "bluetooth": {
    "interval": 120,
    "format": "<span font='Font Awesome 6 Pro Solid'>{icon}</span>",
    "format-icons": [
      ""
    ],
    "tooltip-format-off": "Bluetooth is off",
    "tooltip-format-on": "Bluetooth is on",
    "format-connected": "<span font='Font Awesome 6 Pro Solid'>{icon}</span> {num_connections}",
    "format-disabled": "<span font='Font Awesome 6 Pro Solid'>{icon}</span>",
    "format-connected-battery": "<span font='Font Awesome 6 Pro Solid'>{icon}</span> {device_battery_percentage}%",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_battery_percentage}%",
    "tooltip-format-disabled": "Bluetooth is off",
    "on-click": "kitty --class Bluetui -e bluetui",
    "on-click-right": "bash -c \"rfkill list bluetooth | grep -q 'Soft blocked: yes' && rfkill unblock bluetooth || rfkill block bluetooth\"",
  },
  "backlight": {
    "interval": "once",
    "device": "intel_backlight",
    "format": "{percent}% <span font='Font Awesome 6 Pro Solid'>{icon}</span>",
    "format-icons": [
      "",
      ""
    ],
    "tooltip": false,
    "on-scroll-up": "brightnessctl -e4 -n2 set 5%+",
    "on-scroll-down": "brightnessctl -e4 -n2 set 5%-"
  },
  "wireplumber": {
    "format": "<span font='Font Awesome 6 Pro Solid'>{icon}</span> {volume}%",
    "format-muted": " {volume}%",
    "on-click": "kitty --class Wiremix -e wiremix",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "format-icons": ["", "", ""],
    "scroll-step": 5.0,
  },
  "upower": {
    "interval": "once",
    "icon-size": 12,
    "show-icon": true,
    "format": " {percentage}",
    "tooltip": true,
    "tooltip-format": "{time}",
    "on-click": "~/.config/scripts/charge_limit.sh"
  }
}
